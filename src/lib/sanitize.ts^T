import DOMPurify from 'isomorphic-dompurify'

export function sanitizeText(input: string): string {
  return DOMPurify.sanitize(input, { ALLOWED_TAGS: [] }).trim()
}

export function sanitizePollQuestion(input: string): string {
  const clean = sanitizeText(input)
  if (clean.length < 10) return clean
  return clean.slice(0, 280)
}

export function sanitizePollOption(input: string): string {
  return sanitizeText(input).slice(0, 100)
}

export function sanitizeComment(input: string): string {
  return sanitizeText(input).slice(0, 280)
}

export function sanitizeUsername(input: string): string {
  return sanitizeText(input)
    .toLowerCase()
    .replace(/[^a-z0-9_]/g, '')
    .slice(0, 30)
}
