{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/weekly-pulse",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/daily-poll-summary",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/poll-expiry-reminder",
      "schedule": "0 * * * *"
    }
  ]
}
